# Copy to .env and fill in. .env is gitignored; loaded automatically by src/hiver_agent/config.py.
GEMINI_API_KEY=
# Optional: only if you set a model to anthropic:<model>
ANTHROPIC_API_KEY=

# Model overrides, "<provider>:<model>"
GEN_MODEL=gemini:gemini-3.8-flash
LABEL_MODEL=gemini:gemini-2.5-flash
JUDGE_MODEL=gemini:gemini-2.5-flash

# 1 = allow API calls on cache miss (same as `make eval-live`)
HIVER_LIVE=0
MAX_THREADS=12000
